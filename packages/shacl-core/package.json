{
  "name": "@sd-creation-wizard/shacl-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "n3": "^2.0.0"
  },
  "devDependencies": {
    "@sd-creation-wizard/typescript-config": "workspace:*",
    "@types/n3": "^1.21.1",
    "@vitest/coverage-v8": "^3.2.4",
    "rimraf": "^6.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
