{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "useDefineForClassFields": false,
    "experimentalDecorators": true
  }
}
